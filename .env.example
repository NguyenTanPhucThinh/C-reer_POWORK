# ==============================================================================
# TÀI LIỆU BIẾN MÔI TRƯỜNG DÀNH CHO TOÀN BỘ DỰ ÁN POWORK (ROOT)
# Hướng dẫn: Copy file này thành `.env` để chạy với Docker Compose ở thư mục gốc.
# ==============================================================================

# --- [1] CẤU HÌNH POSTGRESQL DATABASE ---
POSTGRES_USER=powork_user
POSTGRES_PASSWORD=powork_pass
POSTGRES_DB=powork_db

# --- [2] CẤU HÌNH BACKEND API (Node.js) ---
PORT=3001
CLIENT_URL=http://localhost:3000
# Google OAuth is disabled until these are set with values from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Chuỗi kết nối Database (Dành cho Docker, host là `postgres`)
DATABASE_URL="postgresql://powork_user:powork_pass@postgres:5432/powork_db"
# Secret Key để mã hóa JWT Token
JWT_SECRET="powork_super_secret_dev_2026"
JWT_EXPIRES_IN="7d"

# --- [3] CẤU HÌNH SMTP (GỬI EMAIL) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="POWORK <no-reply@powork.vn>"

# --- [4] CẤU HÌNH FRONTEND (Next.js) ---
# URL public dùng cho trình duyệt
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL nội bộ dùng cho server-side rendering trong Docker
INTERNAL_API_URL=http://backend:3001

# --- [5] CẤU HÌNH MINIO (STORAGE) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=powork-submissions
MINIO_PRESIGNED_EXPIRY=300

# --- [6] CẤU HÌNH CLAMAV (DIỆT VIRUS) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
