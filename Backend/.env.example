NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://powork_user:powork_pass@localhost:5432/powork_db"

# JWT
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth — lấy từ Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Gemini API — kiểm duyệt nội dung Challenge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000

# Cloudflare R2 (Object Storage cho file bài nộp và video xác thực)
# Endpoint chỉ là hostname, không thêm https:// và không thêm tên bucket.
R2_ENDPOINT=your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=powork-development
R2_PRESIGNED_EXPIRY=300

# ClamAV (quét virus file nộp)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SMTP (gửi email xác nhận nộp bài)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="POWORK <no-reply@powork.vn>"
