NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://powork_user:powork_pass@localhost:5432/powork_db"

# JWT
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth — lấy từ Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# MinIO (Object Storage cho file bài nộp)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=powork-submissions
MINIO_PRESIGNED_EXPIRY=300

# ClamAV (quét virus file nộp)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SMTP (gửi email xác nhận nộp bài)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="POWORK <no-reply@powork.vn>"
